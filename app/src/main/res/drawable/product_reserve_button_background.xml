<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55F4B942">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#57B83F"
                android:centerColor="#4E9F3D"
                android:endColor="#2F5233"
                android:type="linear" />
