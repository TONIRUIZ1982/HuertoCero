<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55F4B942">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/green_primary"
                android:centerColor="@color/brand_lime"
                android:endColor="@color/green_dark"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_sun" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>
</ripple>
