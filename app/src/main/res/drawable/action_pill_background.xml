<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#F6F1E9"
                android:endColor="#FFFFFF"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_lime" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#FFFFFF"
                android:centerColor="#FFFDF8"
                android:endColor="#EEF8E8"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#DCE8D3" />
        </shape>
    </item>
</selector>
