<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2600B848">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#F2FFF4"
                android:type="linear" />
            <corners android:radius="25dp" />
            <stroke
                android:width="1dp"
                android:color="#CFE9D1" />
            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />
        </shape>
    </item>
</ripple>
