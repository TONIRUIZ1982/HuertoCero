<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="45"
                android:startColor="@color/brand_sun"
                android:endColor="@color/brand_lime"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/background" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="45"
                android:startColor="@color/brand_sun"
                android:centerColor="#FFD766"
                android:endColor="@color/brand_lime"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/background" />
        </shape>
    </item>
</selector>
