<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#F06A42"
                android:centerColor="#E4572E"
                android:endColor="#B93222"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#FFD0C1" />
            <padding
                android:left="14dp"
                android:top="10dp"
                android:right="14dp"
                android:bottom="10dp" />
        </shape>
    </item>
</ripple>
