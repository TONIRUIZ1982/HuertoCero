<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#009E3A"
                android:endColor="#36E86B"
                android:type="linear" />
            <stroke
                android:width="3dp"
                android:color="#B9FFD0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#00E060"
                android:centerColor="#00B848"
                android:endColor="#007B2E"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#9CFFC1" />
        </shape>
    </item>
</selector>
