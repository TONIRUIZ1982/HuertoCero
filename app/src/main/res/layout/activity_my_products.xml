<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_background"
    android:orientation="vertical"
    android:padding="18dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="120dp"
        android:layout_height="54dp"
        android:background="@drawable/button_secondary"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/brand_olive"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/my_products"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/my_products_subtitle"
        android:textColor="@color/muted_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:text="@string/my_products_empty"
        android:textColor="@color/muted_ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listMyProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp" />
</LinearLayout>
