<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/productDialogContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/button_secondary" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/product_image_round"
                android:contentDescription="@string/product_image"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/product_detail_gradient" />

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/category_chip_background"
                android:textColor="@color/brand_olive"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/category_chip_background"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="1/1"
                android:textColor="@color/brand_olive"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="@drawable/category_chip_background"
                android:contentDescription="@string/previous_product"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:background="@drawable/category_chip_background"
                android:contentDescription="@string/next_product"
                android:src="@android:drawable/ic_media_next" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSwipeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/swipe_more"
            android:textColor="@color/muted_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/green_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/category_chip_background"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/badge_eco"
                android:textColor="@color/brand_olive"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/category_chip_background"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/badge_km0"
                android:textColor="@color/brand_olive"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/category_chip_background"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/badge_local"
                android:textColor="@color/brand_olive"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/scarcity_chip_background"
            android:textColor="@color/scarcity"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/muted_ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSeller"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary"
            android:drawableStart="@drawable/ic_action_seller"
            android:drawablePadding="8dp"
            android:drawableTint="@color/brand_olive"
            android:gravity="center"
            android:text="@string/seller_profile"
            android:textAllCaps="false"
            android:textColor="@color/brand_olive"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSellerRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted_ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/seller_trust"
            android:textColor="@color/muted_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFollow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:drawableStart="@drawable/ic_action_user_add"
            android:drawablePadding="8dp"
            android:drawableTint="@color/brand_olive"
            android:gravity="center"
            android:text="@string/follow_seller_category"
            android:textAllCaps="false"
            android:textColor="@color/brand_olive"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_accent"
                android:drawableStart="@drawable/ic_action_chat"
                android:drawablePadding="8dp"
                android:drawableTint="@android:color/white"
                android:gravity="center"
                android:text="@string/chat"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReserve"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_accent"
                android:drawableStart="@drawable/ic_reserve"
                android:drawablePadding="8dp"
                android:drawableTint="@android:color/white"
                android:gravity="center"
                android:text="@string/reserve"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:drawableStart="@drawable/ic_action_heart"
                android:drawablePadding="8dp"
                android:drawableTint="@color/brand_olive"
                android:gravity="center"
                android:text="@string/favorite"
                android:textAllCaps="false"
                android:textColor="@color/brand_olive"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:drawableStart="@drawable/ic_action_route"
                android:drawablePadding="7dp"
                android:drawableTint="@android:color/white"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/take_me_to_product"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReview"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:drawableStart="@drawable/ic_action_star"
                android:drawablePadding="8dp"
                android:drawableTint="@color/brand_olive"
                android:gravity="center"
                android:text="@string/review"
                android:textAllCaps="false"
                android:textColor="@color/brand_olive"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:drawableStart="@drawable/ic_action_flag"
                android:drawablePadding="8dp"
                android:drawableTint="@color/brand_olive"
                android:gravity="center"
                android:text="@string/report"
                android:textAllCaps="false"
                android:textColor="@color/brand_olive"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:drawableStart="@drawable/ic_action_share"
            android:drawablePadding="8dp"
            android:drawableTint="@color/brand_olive"
            android:gravity="center"
            android:text="@string/share_product"
            android:textAllCaps="false"
            android:textColor="@color/brand_olive"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
